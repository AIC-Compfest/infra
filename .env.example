# =================================================================
# UNIFIED ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Evidence-First AI 3PL Invoice Reconciliation Engine
# Copy this file to .env for local development with Docker Compose
# =================================================================

# Global App Environment
APP_ENV=development
LOG_LEVEL=INFO
SCHEMA_VERSION=0.1.0
CONFIG_VERSION=0.1.0

# 1. PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret_change_in_prod
POSTGRES_DB=aic_reconciliation
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_dev_secret_change_in_prod@postgres:5432/aic_reconciliation?sslmode=disable

# 2. Go Backend-API Service
BACKEND_PORT=8080
AI_SERVICE_URL=http://ai-service:8100
WORKER_POLL_INTERVAL_SECONDS=5

# 3. Python AI Service
AI_PORT=8100
MAX_IMAGE_DIMENSION=2048
OCR_DETECTION_THRESHOLD=0.6
OCR_RECOGNITION_THRESHOLD=0.8

# 4. Next.js Frontend Reviewer Workspace
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SCHEMA_VERSION=0.1.0
